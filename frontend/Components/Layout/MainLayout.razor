@inherits LayoutComponentBase
@inject frontend.Services.RoleState State

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Style="background-color: #E60012; color: white;" Fixed="true" Elevation="1">
        <MudText Typo="Typo.h5" Class="font-weight-bold">Stock Replenishment</MudText>
        <MudSpacer />
        
        <div class="d-flex align-center">
            <MudText Typo="Typo.body2" Class="mr-3" Style="white-space: nowrap; font-weight: 500;">
                Simulate Role:
            </MudText>
            
            <MudSelect T="string" Value="@State.CurrentRole" ValueChanged="OnRoleChanged"
                    Variant="Variant.Outlined" 
                    Margin="Margin.Dense" 
                    Dense="true"
                    Style="background-color: white; color: black; border-radius: 4px; width: 140px;">
                <MudSelectItem Value="@("Worker")">Worker</MudSelectItem>
                <MudSelectItem Value="@("Reviewer")">Reviewer</MudSelectItem>
            </MudSelect>
        </div>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private void OnRoleChanged(string newRole)
    {
        State.SetRole(newRole); 
    }
}
